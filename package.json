{
  "name": "sentence-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Sentence Lab — personal tap-only English grammar trainer (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:single": "vite build --mode single && node scripts/make-artifact.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/assistant": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/secular-one": "5.3.0",
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1",
    "workbox-build": "7.4.1"
  }
}
